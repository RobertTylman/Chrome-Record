{
  "name": "audio-splitter-chrome-extension",
  "version": "1.0.6",
  "description": "A Chrome extension to record browser tab audio with waveform editing and WAV/MP3/OGG/WebM export",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "clean": "rm -rf dist",
    "generate-icons": "node scripts/generate-icons.js",
    "build:test": "webpack --config tests/webpack.config.js",
    "test": "npm run build && npm run build:test && playwright test"
  },
  "keywords": [
    "chrome-extension",
    "audio",
    "recording",
    "waveform"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "jszip": "^3.10.1",
    "lamejs": "^1.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.0.268",
    "@types/jszip": "^3.4.0",
    "@types/node": "^25.0.3",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.11.0",
    "html-webpack-plugin": "^5.6.0",
    "path-type": "^6.0.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.34.5",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  }
}
